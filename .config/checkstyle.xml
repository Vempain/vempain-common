<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Team Checkstyle rules.

  SCOPE: only rules the formatter cannot enforce (naming, structure, forbidden constructs, complexity).
  Layout rules (indentation, braces, whitespace, wrapping) are deliberately absent: the Eclipse formatter
  profile owns layout, and duplicating it here would produce conflicting demands.

  The single layout-adjacent rule kept is LineLength, set to the same value as the formatter so the two
  can never disagree. It exists to catch what the formatter cannot break (long string literals, long
  identifiers, URLs in comments) and to make the limit visible in reports.
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java"/>

  <module name="SuppressionFilter">
    <property name="file" value="${checkstyle.suppressions.file}" default=".config/checkstyle-suppressions.xml"/>
    <property name="optional" value="true"/>
  </module>
  <!-- Legacy suppressions: generated by apply-convention.py on first adoption, one entry per file and check that
       violated the rules at that time, so the build gates every other file and check from day one. The file is
       project-owned: fix a file, delete its entry; never add entries. The property is set by the Maven plugin
       configuration (propertyExpansion) so the path resolves from any module. -->
  <module name="SuppressionFilter">
    <property name="file" value="${checkstyle.legacy.suppressions.file}" default=".config/checkstyle-legacy-suppressions.xml"/>
    <property name="optional" value="true"/>
  </module>
  <module name="SuppressWarningsFilter"/>

  <module name="FileTabCharacter"/>
  <module name="NewlineAtEndOfFile"/>

  <module name="LineLength">
    <property name="max" value="160"/>
    <!-- Must match org.eclipse.jdt.core.formatter.lineSplit in eclipse-formatter.xml -->
    <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
  </module>

  <module name="TreeWalker">
    <module name="SuppressWarningsHolder"/>
    <module name="SuppressionCommentFilter">
      <property name="offCommentFormat" value="CHECKSTYLE:OFF"/>
      <property name="onCommentFormat" value="CHECKSTYLE:ON"/>
    </module>

    <!-- Naming -->
    <module name="PackageName">
      <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
    </module>
    <module name="TypeName"/>
    <module name="MethodName"/>
    <module name="ConstantName"/>
    <module name="MemberName"/>
    <module name="ParameterName"/>
    <module name="LocalVariableName"/>
    <module name="LambdaParameterName"/>
    <module name="RecordComponentName"/>
    <module name="ClassTypeParameterName"/>
    <module name="MethodTypeParameterName"/>

    <!-- Imports -->
    <module name="AvoidStarImport"/>
    <module name="IllegalImport"/>
    <module name="RedundantImport"/>
    <module name="UnusedImports"/>

    <!-- Coding -->
    <module name="EmptyBlock">
      <property name="option" value="TEXT"/>
    </module>
    <module name="EmptyCatchBlock">
      <property name="exceptionVariableName" value="ignored|expected"/>
    </module>
    <module name="EmptyStatement"/>
    <module name="EqualsHashCode"/>
    <module name="IllegalCatch">
      <property name="illegalClassNames" value="java.lang.Throwable, java.lang.Error"/>
    </module>
    <module name="MissingSwitchDefault"/>
    <module name="FallThrough"/>
    <module name="MultipleVariableDeclarations"/>
    <module name="NeedBraces"/>
    <module name="OneStatementPerLine"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>
    <module name="StringLiteralEquality"/>
    <module name="OverloadMethodsDeclarationOrder"/>
    <module name="DefaultComesLast"/>
    <module name="ModifierOrder"/>
    <module name="RedundantModifier"/>
    <module name="UpperEll"/>
    <module name="ArrayTypeStyle"/>
    <module name="OuterTypeFilename"/>
    <module name="NoFinalizer"/>

    <!-- Complexity: numbers are starting points, tune from experience -->
    <module name="CyclomaticComplexity">
      <property name="max" value="15"/>
    </module>
    <module name="MethodLength">
      <!-- Same number as the line length, so the two limits are easy to remember together. -->
      <property name="max" value="160"/>
    </module>
    <module name="ParameterNumber">
      <property name="max" value="8"/>
      <property name="ignoreOverriddenMethods" value="true"/>
    </module>
    <module name="NestedIfDepth">
      <property name="max" value="3"/>
    </module>
    <module name="NestedTryDepth">
      <property name="max" value="2"/>
    </module>

    <!-- Javadoc: keep light; enforce correctness of what exists rather than presence everywhere -->
    <module name="InvalidJavadocPosition"/>
    <module name="JavadocMethod">
      <property name="accessModifiers" value="public"/>
      <property name="allowMissingParamTags" value="true"/>
      <property name="allowMissingReturnTag" value="true"/>
    </module>
    <module name="NonEmptyAtclauseDescription"/>
    <module name="AtclauseOrder"/>
  </module>
</module>
